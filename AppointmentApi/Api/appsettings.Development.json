{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=AppointmentDb;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "Secret": "YOUR_VERY_LONG_SECRET_KEY_MUST_BE_AT_LEAST_256_BITS_LONG",
    "Issuer": "AppointmentApi",
    "Audience": "AppointmentApiClients",
    "ExpiryMinutes": 120
  },
  "GoogleCalendarSettings": {
    "CalendarId": "your_calendar_id@group.calendar.google.com",
    "ServiceAccountKeyFilePath": "google-credentials.json",
    "ServiceAccountJson": ""
  }
}
